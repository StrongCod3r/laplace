{
  "name": "laplace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://strongcod3r.github.io/Laplace/",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "tsc --noEmit && vite build && playwright test",
    "prepare:pages": "node scripts/prepare-pages.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d public"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.0.0",
    "gh-pages": "^6.3.0",
    "prettier": "3.9.9",
    "typescript": "^5.7.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "d3-force": "^3.0.0",
    "force-graph": "^1.52.0",
    "isomorphic-git": "^1.43.1",
    "katex": "^0.19.0",
    "lucide": "^1.50.0",
    "pele": "^1.6.0",
    "preact": "^11.0.0",
    "react": "npm:@preact/compat@18.3.2",
    "zustand": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
